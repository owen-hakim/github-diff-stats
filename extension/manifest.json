{
  "manifest_version": 3,
  "name": "GitHub Diff Stats",
  "version": "1.5.0",
  "description": "Split pull request changes into code, tests (including inline Rust tests), and config files (including documentation).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["rust-tests.js", "stats.js", "background.js"]
  },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["rust-tests.js", "stats.js", "content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {"id": "github-diff-stats@owen-hakim", "strict_min_version": "128.0"}
  }
}
